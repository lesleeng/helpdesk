# Helpdesk Module - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# Backend Configuration (Python/FastAPI)
# ============================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/helpdesk_db
# For separate database: postgresql://user:password@localhost:5432/helpdesk
# For shared database with workmate's system: postgresql://user:password@workmate_host:5432/workmate_db

# API
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
# Options: development, staging, production

# Auth - Workmate's System Integration
WORKMATE_AUTH_URL=http://workmate-system.local/api/auth
WORKMATE_DB_URL=postgresql://user:password@workmate_host:5432/workmate_db
# For shared auth, provide JWT secret or OAuth endpoints
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256

# Session
SESSION_TIMEOUT_MINUTES=1440
ENABLE_SESSION_REFRESH=true

# CORS & Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,https://yourdomain.com
SECRET_KEY=your-secret-key-for-sessions

# ============================================
# File Storage
# ============================================

# Local storage (for MVP)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,docx,xlsx,txt

# AWS S3 (optional, for later phases)
# AWS_S3_BUCKET=helpdesk-uploads
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret

# ============================================
# Frontend Configuration (React)
# ============================================

# API
VITE_API_BASE_URL=http://localhost:8000/api
# Production: https://api.yourdomain.com/api

# App
VITE_APP_NAME=Helpdesk
VITE_APP_ENV=development

# Feature flags
VITE_ENABLE_NOTIFICATIONS=false
VITE_ENABLE_AI_SUGGESTIONS=false

# ============================================
# Email & Notifications (Phase 2)
# ============================================

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_ADDRESS=helpdesk@yourdomain.com
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_STARTTLS=true
# Base URL used for ticket links in emails
APP_BASE_URL=http://localhost:5173

# Slack (optional, for Phase 3)
# SLACK_BOT_TOKEN=xoxb-your-token
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# ENABLE_SLACK_NOTIFICATIONS=false
# WEBHOOKS_ALLOW_PRIVATE=false   # allow outbound webhooks to private/internal addresses (dev only)

# ============================================
# Logging & Monitoring
# ============================================

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_METRICS=false

# ============================================
# AI Integration (Phase 3+)
# ============================================

# Claude API (ticket categorization and suggested replies). Ticket text is sent to the API
# when enabled: both a key AND ENABLE_AI_FEATURES=true are required.
# ANTHROPIC_API_KEY=sk-ant-...
ENABLE_AI_FEATURES=false
# AI_MODEL=claude-opus-5-5
# AI_MAX_TOKENS=4096
# AI_RATE_LIMIT_PER_HOUR=30

# ============================================
# Module Settings
# ============================================

# Enable/disable the helpdesk module
HELPDESK_ENABLED=true

# Ticket settings
DEFAULT_TICKET_STATUS=open
REOPEN_WINDOW_DAYS=7
AUTO_CLOSE_DAYS=30

# SLA Settings (Phase 2)
SLA_RESPONSE_TIME_HOURS=24
SLA_RESOLUTION_TIME_HOURS=72

# ============================================
# Development & Testing
# ============================================

DEBUG=false
TESTING=false
# Only enable in development/testing environments

# Database for testing
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/helpdesk_test
